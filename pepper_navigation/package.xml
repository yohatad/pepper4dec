<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pepper_navigation</name>
  <version>0.0.0</version>
  <description>Autonomous navigation for Pepper: Nav2 path planning, obstacle
  avoidance, goal execution, keepout zones, and the saved maps those consume.</description>
  <maintainer email="yohatad123@gmail.com">yoha</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_bringup</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_amcl</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_collision_monitor</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <!-- scripts/: wait_for_map_then_start.py, localization_recovery.py,
       localization_watchdog.py -->
  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>

  <!-- launched by inclusion (pepper_nav2_rtabmap_loc.launch.py), not linked.
       pepper_slam supplies rtabmap_base.launch.py, which this package
       runs in localization mode to get map -> odom and /map. The
       dependency is one-way: pepper_slam never depends on pepper_navigation. -->
  <exec_depend>pepper_slam</exec_depend>
  <!-- pepper_nav2_fastloc.launch.py includes fast_lio's
       localization_l2.launch.py, which runs fastlio_localization. -->
  <exec_depend>fast_lio</exec_depend>
  <!-- pepper_nav2_pointloc.launch.py does the same with point_lio's. -->
  <exec_depend>point_lio</exec_depend>
  <!-- Every pepper_nav2_* bringup starts RViz. -->
  <exec_depend>rviz2</exec_depend>
  <!-- pepper_nav2_amcl.launch.py only: flattens the L2's 360 deg /points into
       the LaserScan amcl requires. Not a Nav2 dependency, so it is NOT pulled
       in by nav2_bringup above; install it with
       "apt install ros-$ROS_DISTRO-pointcloud-to-laserscan". -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <!-- bag_test tooling (launch/bag_test, scripts/cloud_delay.py,
       costmap_explain.py, depth_to_cloud.py, points_to_image.py) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Imported by the launch files and Python nodes. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <!-- test_shared_nav2_params.py parses the four nav2 param files. -->
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
