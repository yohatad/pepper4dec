<package format="3">
  <name>face_detection</name>
  <version>0.1.0</version>
  <description>Face detection node(s)</description>
  <maintainer email="yohatad123@gmail.com">Yohannes</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>dec_interfaces</depend>
  <depend>dec_common</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>onnxruntime_vendor</depend>
  <!-- Launched by face_detection.launch.py for its image sources. -->
  <exec_depend>naoqi_driver</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <!-- Imported by the launch files and Python nodes. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
