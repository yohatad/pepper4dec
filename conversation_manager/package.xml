<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>conversation_manager</name>
  <version>0.0.0</version>
  <description>Conversation Manager a RAG system server wrapper for LLM</description>
  <maintainer email="yohatad123@gmail.com">Yohannes Haile</maintainer>
  <maintainer email="mahadanso79@gmail.com">Muhammed Danso</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <!-- The action type is dec_interfaces/action/ConversationManager. This said
       llm_interfaces, which exists nowhere in the workspace, while the package
       it does import went undeclared. -->
  <depend>dec_interfaces</depend>
  <!-- openai, chromadb and sentence-transformers are deliberately not declared:
       they are pip-only names that rosdep cannot resolve, they live in the
       language_model_env venv, and the tests that need them already skip. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
