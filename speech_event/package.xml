<package format="3">
  <name>speech_event</name>
  <version>0.1.0</version>
  <description>Speech Event Recognition and Localization</description>
  <maintainer email="yohatad123@gmail.com">Yohannes</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>naoqi_bridge_msgs</depend>
  <depend>dec_interfaces</depend>
  <depend>ament_index_python</depend>
  <!-- numpy and scipy are imported at module scope by the denoiser, localization
       and implementation modules. The heavier deps (librosa, pyroomacoustics,
       torch, faster_whisper, onnxruntime) stay undeclared on purpose: they live
       in the dedicated venvs, and their tests skip when absent. -->
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
