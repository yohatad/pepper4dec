<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pepper_slam</name>
  <version>0.0.0</version>
  <description>SLAM and mapping for Pepper: FAST-LIO / Point-LIO lidar-inertial
  odometry, the bridges to the pose-graph loop closure in fastlio_lc_pgo, and
  prior-map localization. Produces the map frame that pepper_navigation
  consumes.</description>
  <maintainer email="yohatad123@gmail.com">yoha</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The C++ nodes in src/: cloud_range_filter, wheel_odom_tf and the two
       bridges. The rig's static TF is robot_state_publisher's (below). -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <!-- All launched by name, not linked against. -->
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- lio_odom_bridge's divergence guard: the wheel trust scale that
       pepper_odom_covariance consumes, and its /diagnostics status. -->

  <!-- NOT declared, deliberately: point_lio, fastlio_lc_pgo and
       pepper_navigation all already exec_depend on pepper_slam, so declaring
       them here would make the dependency graph cyclic and colcon would refuse
       to order the build. The launch files here that reach into them
       (pointlio_*, fastlio_*, the prior-map paths under pepper_navigation/pcd)
       are entry points you run once those packages are present. -->

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- Used by the launch files, which read YAML. -->
  <exec_depend>python3-yaml</exec_depend>

  <!-- Imported by the launch files. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
